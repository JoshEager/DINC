# Copper's Hermes environment. setup.py copies this to hermes/profiles/copper/.env
# on first setup and appends two keys to it, because a profile only sees the keys
# in its own .env:
#   API_SERVER_KEY      your HERMES_API_KEY, which Open WebUI uses to reach Copper
#   OPENROUTER_API_KEY  your OpenRouter key, which Copper uses to think
# Don't set API_SERVER_ENABLED here: the API server is run once for every profile
# by docker-compose.yml, and each profile is reached at /p/<name>/v1 on it.

# The name Copper shows up as in Open WebUI's model picker.
API_SERVER_MODEL_NAME=Copper
